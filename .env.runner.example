# Runner-specific overrides (Windows 10 + WSL2 + Chrome CDP).
# Copy to .env after unpack, or let unpack_runner_state.sh rewrite an existing .env.

DATABASE_URL=sqlite:///./data/trading_bot.db
PLAYWRIGHT_USER_DATA_DIR=data/x-profile
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_CHANNEL=chrome
# WSL → Windows host (nameserver in /etc/resolv.conf, usually first line):
# Use :9223 (Windows cdp_relay.py). Prefer LAN IP (192.168.x.x), not the WSL
# gateway 172.x — Windows Firewall often blocks the Hyper-V adapter.
# Re-run start_chrome.ps1 to rewrite this automatically.
PLAYWRIGHT_CDP_URL=http://192.168.x.x:9223
# true: if the saved X session is gone, wait on the login window instead of polling an empty feed.
PLAYWRIGHT_REQUIRE_LOGIN=true
RUNNER_GIT_BRANCH=main
BOT_API_URL=http://127.0.0.1:8000
