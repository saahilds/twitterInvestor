# Advanced knobs live as defaults in app/config/settings.py — set the env var only to override.

# --- App ---
APP_NAME=twitter-trade-bot
DATABASE_URL=sqlite:///./trading_bot.db
LOG_LEVEL=INFO

# --- X ingest ---
TARGET_ACCOUNT=CKCapitalxx
POLL_INTERVAL_SECONDS=60
TWITTER_BACKEND=playwright
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_USER_DATA_DIR=.playwright/x-profile
PLAYWRIGHT_REQUIRE_LOGIN=true
PLAYWRIGHT_CHANNEL=chrome

# --- Trading mode ---
SIMULATION_MODE=true
ENABLE_LIVE_TRADING=false
BROKER_BACKEND=robinhood
ORDER_EXECUTION_MODE=limit_at_ask

# --- CKCapital sleeve (% base for buys / target-weight sells; not full RH equity) ---
CK_PORTFOLIO_USD=10000.0

# keywords = phrase list only; hybrid = keywords + local TF-IDF model (no LLM API)
SIGNAL_PARSER_BACKEND=hybrid

# --- Robinhood ---
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# ROBINHOOD_MFA_SECRET=
# individual, joint, or exact account_number (uv run python -m app.cli.rh_login --list-accounts)
ROBINHOOD_ACCOUNT=individual
# Optional multi-account: BOT_MANAGERS=individual,joint

# --- Alerts ---
ALERT_WEBHOOK_URL=
ALERT_ENABLED=true
