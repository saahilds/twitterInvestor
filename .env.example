# Advanced knobs live as defaults in app/config/settings.py — set the env var only to override.

# --- App ---
APP_NAME=twitter-trade-bot
DATABASE_URL=sqlite:///./trading_bot.db
LOG_LEVEL=INFO

# --- X ingest ---
TARGET_ACCOUNT=CKCapitalxx
POLL_INTERVAL_SECONDS=60
# Load X only on weekdays 9:30–16:00 ET. Outside that window the bot stays up and quits the bot Chrome.
POLL_ONLY_DURING_MARKET_HOURS=true
TWITTER_BACKEND=playwright
# Leave this false on the WSL runner. The bot attaches to Windows Chrome; headless is what gets X to drop the login.
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_USER_DATA_DIR=.playwright/x-profile
# Wait on the login window if the saved session is gone, instead of polling a logged-out page.
PLAYWRIGHT_REQUIRE_LOGIN=true
PLAYWRIGHT_CHANNEL=chrome

# --- Trading mode ---
SIMULATION_MODE=true
ENABLE_LIVE_TRADING=false
BROKER_BACKEND=robinhood
ORDER_EXECUTION_MODE=limit_at_ask
# Queue BUY/SELL alerts seen outside regular hours for the next open (expire at that session close)
DEFER_OUTSIDE_MARKET_HOURS=true

# --- CKCapital sleeve (% base for buys / target-weight sells; not full RH equity) ---
CK_PORTFOLIO_USD=10000.0

# keywords = phrase list only; hybrid = keywords + local TF-IDF model (no LLM API)
SIGNAL_PARSER_BACKEND=hybrid

# --- Robinhood ---
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# ROBINHOOD_MFA_SECRET=
# individual, joint, or exact account_number (uv run python -m app.cli.rh_login --list-accounts)
ROBINHOOD_ACCOUNT=individual
# Optional multi-account: BOT_MANAGERS=individual,joint

# --- Alerts ---
# Discord/Slack webhook, or https://ntfy.sh/<private-topic> for phone push notifications.
ALERT_WEBHOOK_URL=
ALERT_ENABLED=true
# Dead man's switch ping URL (e.g. healthchecks.io); alerts when the bot or PC goes silent.
HEARTBEAT_PING_URL=
